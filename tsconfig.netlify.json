{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["netlify/functions/**/*.mts", "backend/**/*.mjs"]
}
