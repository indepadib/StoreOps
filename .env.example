# --- Runtime ---
NODE_ENV=development
PORT=8787
STOREOPS_VERSION=1.79.0
STOREOPS_DB=./backend/storeops.db
STOREOPS_MEDIA_DIR=./backend/media
CORS_ORIGINS=https://franprix-storeops.netlify.app

# demo = démonstration ; local = fallback email/mot de passe ; entra = Microsoft professionnel
AUTH_MODE=entra

# --- Microsoft Entra / SSO ---
ENTRA_TENANT_ID=
ENTRA_ALLOWED_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=StoreOps.Access
STOREOPS_API_BASE=
STOREOPS_ENTRA_TENANT_ID=
STOREOPS_ENTRA_CLIENT_ID=
STOREOPS_ENTRA_SPA_CLIENT_ID=
STOREOPS_ENTRA_API_SCOPE=

# --- Utilisateurs pilote (injecter en secret / environnement, jamais dans Git) ---
STOREOPS_VF_MANAGER_EMAIL=
STOREOPS_VF_D365_EMAIL=
STOREOPS_OPS_DIRECTOR_NAME=
STOREOPS_OPS_DIRECTOR_EMAIL=
STOREOPS_OPS_DIRECTOR_D365_EMAIL=
STOREOPS_ADMIN_NAME=Admin StoreOps
STOREOPS_ADMIN_MICROSOFT_EMAIL=
STOREOPS_ADMIN_D365_EMAIL=
STOREOPS_QUALITY_AUDIT_NAME=
STOREOPS_QUALITY_AUDIT_EMAIL=
STOREOPS_QUALITY_AUDIT_MICROSOFT_EMAIL=
STOREOPS_VF_MANAGER_PASSWORD=
STOREOPS_OPS_DIRECTOR_PASSWORD=

# StoreOps reste la source native pour ces domaines sauf intégration RH/caisse future.
STOREOPS_STAFFING_SOURCE=storeops
STOREOPS_CASH_OPENING_SOURCE=storeops

# --- Connecteur Dynamics 365 F&O (un connecteur parmi d'autres) ---
# D365_MODE active le transport/auth. Chaque capability READ s'active séparément après validation métier.
D365_MODE=simulated
D365_PRODUCT_READ_MODE=simulated
D365_STOCK_READ_MODE=simulated
D365_PRICE_READ_MODE=simulated
D365_PROMOTION_READ_MODE=simulated
D365_RECEIVING_READ_MODE=simulated
D365_ASSORTMENT_READ_MODE=simulated
D365_TAXONOMY_READ_MODE=simulated
D365_SALES_READ_MODE=simulated
D365_BASE_URL=https://YOUR-ENV.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_OAUTH_VERSION=v2
D365_DATA_AREA_ID=
D365_DATA_AREA_FIELD=dataAreaId
D365_ODATA_PAGE_SIZE=500
D365_ODATA_MAX_ROWS=25000

# --- Catalogue / EAN ---
D365_BARCODE_ENTITY=
D365_PRODUCT_ENTITY=
D365_BARCODE_FIELD=Barcode
D365_BARCODE_PRODUCT_FIELD=ItemNumber
D365_BARCODE_DESCRIPTION_FIELD=Description
D365_BARCODE_UNIT_FIELD=UnitID
D365_PRODUCT_NUMBER_FIELD=ProductNumber
D365_PRODUCT_NAME_FIELD=ProductName

# --- Prix / promotions ---
D365_DEFAULT_PRICE_GROUP=Franprix
D365_STORE_PRICE_GROUPS=val-fleuri=Franprix
D365_BASE_PRICE_ENTITY=ReleasedProductsV2
D365_SALES_PRICE_ENTITY=SalesPriceAgreements
D365_RETAIL_DISCOUNT_ENTITY=RetailDiscounts
D365_RETAIL_DISCOUNT_LINE_ENTITY=RetailDiscountLines
D365_RETAIL_DISCOUNT_PRICE_GROUP_ENTITY=RetailDiscountPriceGroups
D365_MIX_MATCH_LINE_GROUP_ENTITY=MixAndMatchLineGroups

# --- Stock magasin / entrepôt source ---
# Chaque magasin doit être mappé explicitement. Le stock principal additionne toutes les lignes/dimensions.
D365_STOCK_ENTITY=WarehousesOnHandV2
D365_STOCK_PRODUCT_FIELD=ItemNumber
D365_STOCK_NAME_FIELD=
D365_STOCK_EAN_FIELD=
D365_STOCK_WAREHOUSE_FIELD=InventoryWarehouseId
D365_STOCK_AVAILABLE_FIELD=AvailableOnHandQuantity
D365_STOCK_PHYSICAL_FIELD=OnHandQuantity
# Facultatif : pour exposer le détail des lots/emplacements/statuts après agrégation complète.
D365_STOCK_BATCH_FIELD=
D365_STOCK_LOCATION_FIELD=
D365_STOCK_STATUS_FIELD=
D365_STORE_WAREHOUSES=val-fleuri=FRP0001
# À mapper sur le véritable warehouse qui approvisionne chaque magasin.
D365_STORE_SUPPLY_WAREHOUSES=
D365_STOCK_MAX_OUT_OF_STOCK=100
D365_STOCK_PAGE_SIZE=500
D365_STOCK_MAX_ROWS=25000

# --- Réception / Purchase Orders READ ---
# Les écritures réception restent bloquées jusqu'à mapping write validé.
D365_PO_HEADER_ENTITY=PurchaseOrderHeadersV2
D365_PO_LINE_ENTITY=PurchaseOrderLinesV2
D365_PO_NUMBER_FIELD=PurchaseOrderNumber
D365_PO_VENDOR_FIELD=OrderVendorAccountNumber
D365_PO_HEADER_DATE_FIELD=RequestedDeliveryDate
D365_PO_STATUS_FIELD=PurchaseOrderStatus
D365_PO_HEADER_WAREHOUSE_FIELD=DefaultReceivingWarehouseId
D365_PO_LINE_NUMBER_FIELD=LineNumber
D365_PO_PRODUCT_FIELD=ItemNumber
D365_PO_DESCRIPTION_FIELD=LineDescription
D365_PO_BARCODE_FIELD=Barcode
D365_PO_CATEGORY_FIELD=ProcurementProductCategoryName
D365_PO_ORDERED_QTY_FIELD=OrderedPurchaseQuantity
D365_PO_RECEIVED_QTY_FIELD=ReceivedPurchaseQuantity
D365_PO_REMAINING_QTY_FIELD=RemainingPurchaseQuantity
D365_PO_UNIT_FIELD=PurchaseUnitSymbol
D365_PO_LINE_DATE_FIELD=RequestedDeliveryDate
D365_PO_WAREHOUSE_FIELD=ReceivingWarehouseId
D365_PO_PAGE_SIZE=250
D365_PO_MAX_ROWS=10000

# --- Taxonomie produit : hiérarchie catégorie/famille ---
D365_CATEGORY_HIERARCHY_KEY=PROCUREMENT
D365_CATEGORY_ENTITY=ProcurementProductCategories
D365_PRODUCT_CATEGORY_ASSIGNMENT_ENTITY=ProductCategoryAssignments
# Les champs ci-dessous doivent être validés sur Metadata/DataEntities avant LIVE.
D365_CATEGORY_ID_FIELD=
D365_CATEGORY_NAME_FIELD=
D365_CATEGORY_PARENT_FIELD=
D365_CATEGORY_LEVEL_FIELD=
D365_CATEGORY_PATH_FIELD=
D365_CATEGORY_HIERARCHY_FIELD=
D365_PRODUCT_CATEGORY_PRODUCT_FIELD=
D365_PRODUCT_CATEGORY_CATEGORY_FIELD=
D365_PRODUCT_CATEGORY_HIERARCHY_FIELD=
D365_MERCH_PAGE_SIZE=500
D365_MERCH_MAX_ROWS=50000

# --- Assortiment magasin ---
# IMPORTANT : ne pas activer LIVE avant d'avoir identifié l'entité finale assortiment x canal/magasin.
D365_ASSORTMENT_ENTITY=
D365_ASSORTMENT_STORE_FIELD=
D365_ASSORTMENT_PRODUCT_FIELD=
D365_ASSORTMENT_ID_FIELD=
D365_ASSORTMENT_NAME_FIELD=
D365_ASSORTMENT_INCLUDED_FIELD=
D365_ASSORTMENT_VALID_FROM_FIELD=
D365_ASSORTMENT_VALID_TO_FIELD=
D365_STORE_CHANNELS=
D365_ASSORTMENT_PAGE_SIZE=500
D365_ASSORTMENT_MAX_ROWS=50000
STOREOPS_ASSORTMENT_MAX_AGE_HOURS=36

# --- Ventes / Business Pulse / vélocité article ---
# Les noms par défaut sont des hypothèses configurables : valider l'entité réelle avant LIVE.
D365_SALES_ENTITY=RetailTransactionSalesTransBIEntities
D365_STORE_RETAIL_IDS=
D365_SALES_STORE_FIELD=store
D365_SALES_DATE_FIELD=businessDate
D365_SALES_DATE_FILTER_MODE=datetime
D365_SALES_TRANSACTION_FIELD=transactionId
D365_SALES_NET_FIELD=netAmountInclTax
D365_SALES_QTY_FIELD=qty
D365_SALES_PRODUCT_FIELD=itemId
D365_SALES_PRODUCT_NAME_FIELD=
D365_SALES_COST_FIELD=
D365_SALES_TIME_FIELD=time
D365_SALES_DEPARTMENT_FIELD=
D365_SALES_CATEGORY_FIELD=
D365_SALES_SIGN=-1
D365_SALES_COST_SIGN=-1
D365_SALES_QTY_SIGN=1
D365_SALES_PAGE_SIZE=1000
D365_SALES_MAX_ROWS=50000
STOREOPS_BUSINESS_PULSE_CACHE_SECONDS=90
STOREOPS_SALES_VELOCITY_CACHE_SECONDS=300

# --- Politique de recommandation réappro (fallback global) ---
# Une future configuration tenant/magasin/article pourra surcharger ces defaults.
STOREOPS_REPLENISHMENT_LEAD_TIME_DAYS=1
STOREOPS_REPLENISHMENT_SAFETY_DAYS=1
STOREOPS_REPLENISHMENT_PACK_SIZE=1
STOREOPS_REPLENISHMENT_MIN_ORDER_QTY=0
STOREOPS_REPLENISHMENT_PROMO_FACTOR=1
STOREOPS_REPLENISHMENT_DAY_FACTOR=1

# --- Closing Pack démarque / pertes ---
# JSON d'un template exact d'import ERP. Tant qu'il est vide, StoreOps génère seulement un CSV d'audit
# et refuse de considérer l'import ERP comme confirmé.
STOREOPS_LOSS_EXPORT_TEMPLATE_JSON=

CLOSING_VARIANCE_TOLERANCE_DH=1
