# --- Runtime ---
NODE_ENV=development
PORT=8787
STOREOPS_VERSION=1.29.0
STOREOPS_DB=./backend/storeops.db
STOREOPS_MEDIA_DIR=./backend/media
CORS_ORIGINS=https://franprix-storeops.netlify.app

# demo = x-demo-user ; entra = JWT Microsoft Entra obligatoire
AUTH_MODE=demo
ENTRA_TENANT_ID=
ENTRA_ALLOWED_TENANT_ID=
ENTRA_API_CLIENT_ID=

# --- Pilote Val Fleuri ---
# Ne jamais committer les vraies valeurs dans GitHub : renseigner ces variables dans l'environnement backend/Azure.
STOREOPS_VF_MANAGER_EMAIL=
STOREOPS_VF_D365_EMAIL=

# --- Dynamics 365 Finance & Operations ---
# simulated | live
D365_MODE=simulated
D365_BASE_URL=https://YOUR-ENV.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
# v2 par défaut ; v1 possible si votre environnement exige resource=...
D365_OAUTH_VERSION=v2

# Société / legal entity ciblée dans F&O
D365_DATA_AREA_ID=
D365_DATA_AREA_FIELD=dataAreaId

# Entités à identifier via /api/dynamics/entities après connexion
D365_BARCODE_ENTITY=
D365_PRODUCT_ENTITY=
D365_BARCODE_FIELD=Barcode
D365_BARCODE_PRODUCT_FIELD=ItemNumber
D365_BARCODE_DESCRIPTION_FIELD=Description
D365_BARCODE_UNIT_FIELD=UnitID
D365_PRODUCT_NUMBER_FIELD=ProductNumber
D365_PRODUCT_NAME_FIELD=ProductName

# Contexte prix Commerce
D365_DEFAULT_PRICE_GROUP=Franprix
# Format clé=valeur séparé par virgules, ou objet JSON.
# Exemple actuel : les magasins ouverts utilisent le groupe Franprix.
D365_STORE_PRICE_GROUPS=val-fleuri=Franprix,trefle=Franprix

# Pagination des Data Entities volumineuses (ex. RetailDiscountLines)
D365_ODATA_PAGE_SIZE=500
D365_ODATA_MAX_ROWS=25000

# Tolérance de clôture financière en DH
CLOSING_VARIANCE_TOLERANCE_DH=1
