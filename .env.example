# --- Runtime ---
NODE_ENV=development
PORT=8787
STOREOPS_VERSION=1.29.0
STOREOPS_DB=./backend/storeops.db
STOREOPS_MEDIA_DIR=./backend/media
CORS_ORIGINS=https://franprix-storeops.netlify.app

# demo = démonstration ; local = fallback email/mot de passe ; entra = Microsoft professionnel
AUTH_MODE=entra

# --- Microsoft Entra : configuration pilote recommandée ---
# Une seule App Registration suffit pour le pilote StoreOps.
# Les deux valeurs métier à récupérer sont le Tenant ID et l'Application (client) ID.
ENTRA_TENANT_ID=
ENTRA_ALLOWED_TENANT_ID=
ENTRA_CLIENT_ID=
# Compatibilité avec les anciens déploiements : peut rester vide si ENTRA_CLIENT_ID est renseigné.
ENTRA_API_CLIENT_ID=
ENTRA_REQUIRED_SCOPE=StoreOps.Access

# --- Frontend Netlify / SPA Microsoft ---
STOREOPS_API_BASE=
STOREOPS_ENTRA_TENANT_ID=
STOREOPS_ENTRA_CLIENT_ID=
# Ces anciens champs restent supportés mais ne sont plus nécessaires avec une App Registration unique.
STOREOPS_ENTRA_SPA_CLIENT_ID=
STOREOPS_ENTRA_API_SCOPE=

# --- Utilisateurs autorisés du pilote ---
# Emails uniquement dans l'environnement du backend, jamais dans GitHub.
STOREOPS_VF_MANAGER_EMAIL=
STOREOPS_VF_D365_EMAIL=
STOREOPS_OPS_DIRECTOR_NAME=Mourad
STOREOPS_OPS_DIRECTOR_EMAIL=

# --- Fallback local temporaire, désactivé tant que AUTH_MODE=entra ---
STOREOPS_VF_MANAGER_PASSWORD=
STOREOPS_OPS_DIRECTOR_PASSWORD=

# Au lancement, ces flux restent gérés dans StoreOps même si D365_MODE=live.
STOREOPS_STAFFING_SOURCE=storeops
STOREOPS_CASH_OPENING_SOURCE=storeops

# --- Dynamics 365 Finance & Operations ---
# simulated | live
D365_MODE=simulated
D365_BASE_URL=https://YOUR-ENV.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_OAUTH_VERSION=v2

D365_DATA_AREA_ID=
D365_DATA_AREA_FIELD=dataAreaId
D365_BARCODE_ENTITY=
D365_PRODUCT_ENTITY=
D365_BARCODE_FIELD=Barcode
D365_BARCODE_PRODUCT_FIELD=ItemNumber
D365_BARCODE_DESCRIPTION_FIELD=Description
D365_BARCODE_UNIT_FIELD=UnitID
D365_PRODUCT_NUMBER_FIELD=ProductNumber
D365_PRODUCT_NAME_FIELD=ProductName
D365_DEFAULT_PRICE_GROUP=Franprix
D365_STORE_PRICE_GROUPS=val-fleuri=Franprix,trefle=Franprix
D365_ODATA_PAGE_SIZE=500
D365_ODATA_MAX_ROWS=25000
CLOSING_VARIANCE_TOLERANCE_DH=1
